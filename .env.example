APP_NAME="Sistem Pengadaan Supplier"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ───────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=procurement_db
DB_USERNAME=root
DB_PASSWORD=

# ─── Cache & Session ────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=480

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@perusahaan.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Filament Admin ──────────────────────────────────────────────────────────
FILAMENT_ADMIN_PATH=admin

# ─── Vite / Vue Frontend ─────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Jika menggunakan S3 (opsional):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# ─── Procurement Konfigurasi ─────────────────────────────────────────────────
# Batas hari deadline default untuk distribusi PR
PR_DEFAULT_DEADLINE_DAYS=7

# Batas maksimal ukuran file upload (dalam KB)
MAX_FILE_SIZE_KB=10240

# Maksimal jumlah penawaran per PR per supplier
MAX_QUOTATIONS_PER_PR=3
